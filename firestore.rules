rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Common functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUserRole(role) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isAdmin() {
      return isUserRole('admin');
    }
    
    function isFaculty() {
      return isUserRole('faculty');
    }
    
    function isStudent() {
      return isUserRole('student');
    }
    
    function isProjectCreator(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isSignedIn() && (project.facultyId == request.auth.uid || project.mentorId == request.auth.uid);
    }
    
    // PUBLIC COLLECTIONS - no authentication required
    match /waitlistprojects/{projectId} {
      allow read, write: if true;
    }
    
    match /waitlist/{docId} {
      allow read, write: if true;
    }
    
    // Users collection - for authentication
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Projects collection - with simplified access
    match /projects/{projectId} {
      // Anyone can read project data
      allow read: if true;
      
      // Any authenticated user can create a project
      allow create: if isSignedIn();
      
      // Update requires being the creator or admin
      allow update: if isSignedIn() && (isProjectCreator(projectId) || isAdmin());
      
      // Delete requires creator or admin access
      allow delete: if isSignedIn() && (isProjectCreator(projectId) || isAdmin());
    }
    
    // Materials collection
    match /materials/{materialId} {
      // Anyone can view materials 
      allow read: if true;
      
      // Create/update/delete require authentication
      allow create, update, delete: if isSignedIn();
    }
    
    // Positions collection
    match /positions/{positionId} {
      // Anyone can view positions
      allow read: if true;
      
      // Create/update/delete require authentication
      allow create, update, delete: if isSignedIn();
    }
    
    // Applications collection
    match /applications/{applicationId} {
      // Read requires authentication
      allow read: if isSignedIn();
      
      // Create/update/delete require authentication
      allow create, update, delete: if isSignedIn();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // TEMPORARY DEVELOPMENT ACCESS
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}